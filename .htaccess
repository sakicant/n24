# N24 Real Estate on LiteSpeed/Apache. Upload to the web root of n24.hr.
# Main address: https://n24.hr
# www.n24.hr and plain http are sent there permanently, keeping the path.

RewriteEngine On

# ---------------------------------------------------------------- one address
RewriteCond %{HTTP_HOST} !^n24\.hr$ [NC,OR]
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://n24.hr/$1 [R=301,L]

# ---------------------------------------------------------------- languages
# Croatian is at the root, the other languages under /en/, /de/, /pl/, /cs/, /sk/,
# each with translated addresses (made by tools/build.mjs).
#
# The English site was at the root until November 2026: its addresses move to /en/.
RewriteRule ^properties-for-sale(/.*)?$ /en/properties/ [R=301,L]
RewriteRule ^(properties|services|about|contact|privacy-policy|terms)/?$ /en/$1/ [R=301,L]
RewriteRule ^real-estate-(vodice|srima|sibenik|brodarica|zaboric|grebastica|primosten|rogoznica)/?$ /en/real-estate-$1/ [R=301,L]
RewriteRule ^property/(.*)$ /en/property/$1 [R=301,L]
# The empty /hr/ and /de/ placeholders of the first version.
RewriteRule ^hr(/.*)?$ / [R=301,L]
RewriteRule ^de/about/?$ /de/ueber-uns/ [R=301,L]
RewriteRule ^de/services/?$ /de/leistungen/ [R=301,L]
RewriteRule ^de/properties/?$ /de/immobilien/ [R=301,L]
RewriteRule ^de/contact/?$ /de/kontakt/ [R=301,L]
RewriteRule ^de/privacy-policy/?$ /de/datenschutz/ [R=301,L]
RewriteRule ^de/terms/?$ /de/nutzungsbedingungen/ [R=301,L]
RewriteRule ^de/real-estate-([a-z]+)/?$ /de/immobilien-$1/ [R=301,L]
RewriteRule ^de/property/(.*)$ /de/immobilie/$1 [R=301,L]

# Property pages are made by PHP from the listings saved in the admin, in every language.
RewriteRule ^((?:nekretnina|en/property|de/immobilie|pl/oferta|cs/nemovitost|sk/nehnutelnost)/[a-z0-9-]+)$ /$1/ [R=301,L]
RewriteRule ^nekretnina/([a-z0-9-]+)/$ api/property.php?lang=hr&slug=$1 [L,QSA]
RewriteRule ^en/property/([a-z0-9-]+)/$ api/property.php?lang=en&slug=$1 [L,QSA]
RewriteRule ^de/immobilie/([a-z0-9-]+)/$ api/property.php?lang=de&slug=$1 [L,QSA]
RewriteRule ^pl/oferta/([a-z0-9-]+)/$ api/property.php?lang=pl&slug=$1 [L,QSA]
RewriteRule ^cs/nemovitost/([a-z0-9-]+)/$ api/property.php?lang=cs&slug=$1 [L,QSA]
RewriteRule ^sk/nehnutelnost/([a-z0-9-]+)/$ api/property.php?lang=sk&slug=$1 [L,QSA]
RewriteRule ^sitemap\.xml$ api/sitemap.php [L]

# ---------------------------------------------------------------- pages
DirectoryIndex index.html index.php
# Never show a list of a folder's files.
Options -Indexes
# The 404 page in the language of the address.
ErrorDocument 404 /api/notfound.php

# Nothing outside the website itself should be reachable. The admin lives at
# /manage/ (not listed anywhere); the old /admin/ address is dead.
RewriteRule ^admin(/.*)?$ - [R=404,L]
RewriteRule ^(src|tools|content|\.impeccable|\.claude|\.git)(/|$) - [F,L]
RewriteRule ^api/(lib|data|views)(/|$) - [F,L]
RewriteRule ^api/check-webp\.php$ - [F,L]
RewriteRule \.(md|py|mjs|json\.bak|log)$ - [F,L]

# ---------------------------------------------------------------- headers and caching
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
</IfModule>

# The admin and listing data change at any time: never cached.
<IfModule mod_headers.c>
  <FilesMatch "listings\.json$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType video/mp4 .mp4
  AddType font/woff2 .woff2
</IfModule>
