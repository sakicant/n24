# N24 Real Estate on LiteSpeed/Apache. Upload to the web root of n24.hr.
# Main address: https://n24.hr
# www.n24.hr and plain http are sent there permanently, keeping the path.

RewriteEngine On

# ---------------------------------------------------------------- one address
RewriteCond %{HTTP_HOST} !^n24\.hr$ [NC,OR]
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://n24.hr/$1 [R=301,L]

# Old search URL from the first preview of this site
RewriteRule ^properties-for-sale(/.*)?$ /properties/ [R=301,L]

# ---------------------------------------------------------------- pages
DirectoryIndex index.html
ErrorDocument 404 /404.html

# Nothing outside the website itself should be reachable.
RewriteRule ^(src|tools|content|\.impeccable|\.claude|\.git)(/|$) - [F,L]
RewriteRule ^api/(lib|data)(/|$) - [F,L]
RewriteRule \.(md|py|mjs|json\.bak|log)$ - [F,L]

# ---------------------------------------------------------------- headers and caching
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 1 hour"
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
</IfModule>
